+    def _click_past_overlay(self, element, label: str, timeout_s: int = 180) -> None:
+        """Click an element, waiting out any overlay that intercepts the click.
+
+        Garmin SSO sometimes shows a reCAPTCHA challenge covering the login
+        form. The challenge must be solved by a human in the (visible) browser
+        window — we never attempt to solve it, we only wait and retry.
+        """
+        warned = False
+        deadline = time.time() + timeout_s
+        while True:
+            try:
+                element.click()
+                return
+            except ElementClickInterceptedException:
+                if not warned:
+                    warned = True
+                    print(f"  An overlay is blocking the {label} field (reCAPTCHA challenge?).")
+                    print("  Solve it in the browser window — waiting up to "
+                          f"{timeout_s}s...")
+                if time.time() > deadline:
+                    raise
+                time.sleep(2)
+
     def _type_slowly(self, text: str, delay_s: float = 0.03) -> None:
